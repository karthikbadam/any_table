{
  "name": "@any_table/react",
  "version": "0.1.5",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai/schema.json": "./ai/schema.json",
    "./ai/llms.txt": "./ai/llms.txt",
    "./ai/claude.md": "./ai/claude.md"
  },
  "files": [
    "dist",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/karthikbadam/any_table.git",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsup && pnpm run build:schema",
    "build:schema": "tsx scripts/generate-schema.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@any_table/core": "workspace:*",
    "@any_table/spec": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@uwdata/mosaic-core": ">=0.10.0",
    "@uwdata/mosaic-sql": ">=0.10.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@uwdata/mosaic-core": {
      "optional": true
    },
    "@uwdata/mosaic-sql": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@uwdata/mosaic-core": "^0.12.0",
    "@uwdata/mosaic-sql": "^0.12.0",
    "jsdom": "^25.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.8"
  }
}
